# Copy to .env and fill in. Never commit .env.

# Clio Manage developer app (read-only scopes). Redirect URI must match exactly.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://localhost:3000/api/clio/callback
CLIO_BASE_URL=https://app.clio.com

# GMI Cloud (OpenAI-style API). Pick model ids from GET $GMI_BASE_URL/models.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
LLM_MODEL=
LLM_MODEL_FAST=
# Optional: a text-to-speech model id from GMI. Empty = browser voice.
TTS_MODEL=

# Optional: embeddings for the semantic half of search. Empty = keyword-only.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# openssl rand -hex 32
SESSION_SECRET=

DATABASE_URL=postgres://casebrief:casebrief@localhost:5432/casebrief

# Assumed contingency fee used only for the illustrative net-to-client figure.
FEE_FRACTION=0.3333
# Serve the made-up fixture case instead of synced data (1 = on).
USE_FIXTURES=
